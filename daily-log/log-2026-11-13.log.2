ENTIAL_CONSTRAINTS` WHERE `CONSTRAINT_SCHEMA` = 'meeting_room_booking_system' AND `TABLE_NAME` = 'user_roles') `rc` ON `s`.`INDEX_NAME` = `rc`.`CONSTRAINT_NAME` AND `s`.`TABLE_SCHEMA` = `rc`.`CONSTRAINT_SCHEMA` WHERE `s`.`INDEX_NAME` != 'PRIMARY' AND `rc`.`CONSTRAINT_NAME` IS NULL"}
